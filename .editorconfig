root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{c,cpp,h}]
indent_style = space
indent_size = 2

[*.{cmake,md,ps1}]
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_style = space
indent_size = 2

[*.ps1]
end_of_line = crlf

[*.sh]
indent_style = space
indent_size = 4

[third_party/**]
trim_trailing_whitespace = unset
