{
  "schema_version": 4,
  "product": "APFS for Windows",
  "decision_date": "2026-11-22",
  "release_model": "owner_controlled_signed_distribution",
  "application_signing": {
    "required": true,
    "status": "azure_artifact_signing",
    "publisher": "CN=Randy Northrup",
    "smart_app_control_reputation_guaranteed": false
  },
  "package_signing": {
    "required": true,
    "status": "azure_artifact_signing",
    "artifacts": ["msi", "setup_exe"],
    "integrity_mechanism": "authenticode_msi_setup_and_sha256sums"
  },
  "installer": {
    "format": "msi",
    "bundle": "wix_burn_setup_exe",
    "toolset": "wix_5.0.2",
    "chains_official_winfsp": true,
    "winfsp_dependency": "dependencies/winfsp.json"
  },
  "kernel_driver_trust": {
    "required": true,
    "distribution_mode": "official_winfsp_system_install",
    "driver_signer": "Microsoft Windows Hardware Compatibility Publisher",
    "test_mode_required": false,
    "secure_boot_compatible": true,
    "integrity_bypass_is_not_permitted": true,
    "secure_boot_or_integrity_bypass_automation_permitted": false
  },
  "native_hard_link_creation": "unsupported_with_official_winfsp",
  "physical_fault_recovery": {
    "status": "not_physically_tested",
    "owner_accepts_residual_risk": true,
    "reason": "No physical surprise-unplug or power-loss simulation is available.",
    "permitted_claim": "Synthetic process-termination and raw interruption tested; physical unplug and power loss untested."
  },
  "source_control": {
    "only_branch": "main",
    "release_tags_must_point_to_main": true,
    "signed_tags_required": false
  },
  "public_production_claim_permitted": false
}
